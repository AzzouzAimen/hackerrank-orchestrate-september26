        "confirmation_state": {
          "enum": [
            "confirmed",
            "uncertain"
          ],
          "title": "Confirmation State",
          "type": "string"
        },
        "unresolved_fields": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Fields",
          "type": "array"
